# Aplicación
NODE_ENV=development
APP_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/usdt_wallet
MONGODB_DB=usdt_wallet

# Autenticación
# Generar un valor aleatorio largo antes de producción.
AUTH_SECRET=replace-with-a-long-random-secret

# Administrador inicial
# Se utilizan únicamente al ejecutar: npm run create-admin
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-secure-password

# TRON
# Valores admitidos: nile | mainnet
TRON_NETWORK=nile

# Endpoints RPC. Si se omiten, tron.config.ts utiliza estos valores oficiales.
TRON_NILE_FULL_HOST=https://nile.trongrid.io
TRON_MAINNET_FULL_HOST=https://api.trongrid.io

# API key de TronGrid. Puede quedar vacía durante el desarrollo en Nile.
TRON_API_KEY=

# Máximo fee_limit aceptado por el endpoint de broadcast.
# 100000000 SUN = 100 TRX.
TRON_BROADCAST_MAX_FEE_LIMIT_SUN=100000000

# Seguridad de la wallet perteneciente a la plataforma
# Debe contener exactamente 64 caracteres hexadecimales.
# Generar con: openssl rand -hex 32
# Nunca versionar el valor real.
WALLET_ENCRYPTION_KEY=replace-with-64-hex-characters

# Workers
# Intervalo mínimo aceptado para depósitos: 10000 ms.
DEPOSIT_WORKER_INTERVAL_MS=60000

# Intervalo mínimo aceptado para el scanner TRON: 5000 ms.
TRON_SCANNER_INTERVAL_MS=15000

# Cantidad permitida: 1 a 200 bloques por ciclo.
TRON_SCANNER_MAX_BLOCKS_PER_CYCLE=20

# Vacío: comenzar desde el último bloque solidificado actual.
TRON_SCANNER_START_BLOCK=
