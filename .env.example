# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/usdt_wallet
MONGODB_DB=usdt_wallet

# Authentication
# Generate a long random value for production.
AUTH_SECRET=replace-with-a-long-random-secret

# TRON
# Start with Nile testnet. Do not place a production private key here yet.
TRON_NETWORK=nile
TRON_FULL_HOST=https://nile.trongrid.io
TRON_API_KEY=
USDT_TRC20_CONTRACT=

# Wallet security
# Reserved for encrypted key material later. Never commit real secrets.
WALLET_ENCRYPTION_KEY=
